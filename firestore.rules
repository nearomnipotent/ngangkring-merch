rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone who opens the page signs in anonymously and can read and write
    // this event's merch data. Nothing else in the database is reachable.
    match /events/{eventId}/{collection}/{docId} {
      allow read, write: if request.auth != null
        && collection in ['stock', 'log', 'preorders'];
    }
  }
}
